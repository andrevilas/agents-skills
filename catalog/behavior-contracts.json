{
  "schemaVersion": 1,
  "source": "design §5.6 V12 (replaces the hard-coded paths of scripts/validate-skill-behavior.sh)",
  "rule": "V12 checks every assertion against dist/ for every listed skill and target. `contains` fails when the text is missing from the resolved files (for scope `bundle`: from all of them together); `absent` fails when the text appears in any resolved file. `section` limits the check to the lines from that heading to the next `## ` heading.",
  "scopes": {
    "skill": {
      "antigravity": [
        "dist/antigravity/<id>/SKILL.md"
      ],
      "claude-code": [
        "dist/claude-code/<id>/SKILL.md"
      ],
      "codex": [
        "dist/codex/<id>/SKILL.md"
      ],
      "generic": [
        "dist/generic/<id>.md"
      ]
    },
    "bundle": {
      "antigravity": [
        "dist/antigravity/<id>/**"
      ],
      "claude-code": [
        "dist/claude-code/<id>/**"
      ],
      "codex": [
        "dist/codex/<id>/**"
      ],
      "generic": [
        "dist/generic/<id>.md",
        "dist/generic/<id>.flows.md",
        "dist/generic/<id>.refs.md",
        "dist/generic/<id>.tools.md"
      ]
    }
  },

  "notFor": [
    {
      "when": "API keys, AI provider keys or agent credentials",
      "skill": "lpm-access"
    },
    {
      "when": "creating, approving or dispatching AISH jobs",
      "skill": "lpm-aish-jobs"
    },
    {
      "when": "runner hosts, leases or a runner recording its consumption",
      "skill": "lpm-aish-runners"
    },
    {
      "when": "answering a code question with the Advisor",
      "skill": "lpm-ask-advisor"
    },
    {
      "when": "refreshing or activating a code index",
      "skill": "lpm-code-index"
    },
    {
      "when": "deploying LPM or changing its environment variables",
      "skill": "lpm-release-product"
    }
  ],
  "owns": [
    "adjust_aish_consumption",
    "configure_aish_budget",
    "configure_aish_financial_pool",
    "fund_aish_job",
    "get_aish_accounting",
    "get_aish_budget",
    "get_aish_financial_pool",
    "get_aish_financial_report",
    "get_aish_usage_report",
    "get_owner_agent_usage",
    "get_workspace_ai_config",
    "import_aish_accounting",
    "list_aish_consumption",
    "list_workspace_ai_provider_models",
    "reconcile_aish_accounting",
    "record_aish_financial_pool_cost",
    "set_aish_financial_visibility",
    "settle_aish_budget",
    "update_workspace_ai_config"
  ],
  "uses": [
    "get_aish_job",
    "list_aish_jobs",
    "list_issues",
    "list_workspace_ai_credentials",
    "list_workspace_projects",
    "list_workspaces"
  ],
  "cli": [
    "aish consumption",
    "aish usage report"
  ],
  "sharedRefs": [
    {
      "name": "ai-cost-and-budgets",
      "loadWhen": "an AI cost, limit, quota or fallback question comes up",
      "inlineSummary": false
    },
    {
      "name": "authority-and-owner-decisions",
      "loadWhen": "an [O] call or a decision request is next",
      "inlineSummary": false
    }
  ],
  "references": [
    {
      "file": "references/workspace-ai-policy.md",
      "loadWhen": "reading or changing AI config"
    },
    {
      "file": "references/budget-model.md",
      "loadWhen": "an AISH money question or an AISH financial write"
    },
    {
      "file": "references/accounting.md",
      "loadWhen": "consumption receipts, accounting, reconcile or import"
    },
    {
      "file": "references/flow-aish-write.md",
      "loadWhen": "decision row 5 of SKILL.md"
    },
    {
      "file": "references/flow-ai-status.md",
      "loadWhen": "playbook ai-status: read the workspace AI policy, models, limits or spend, explain an Advisor fallbackReason, or read today's code-search quota"
    },
    {
      "file": "references/flow-change-ai-config.md",
      "loadWhen": "playbook change-ai-config: change the workspace AI model, a usage limit, a feature flag, enabled or the providers, on the owner's order (no order: send the decision request)"
    }
  ],
  "behaviorContracts": [
    "ai-cost-advisor-gate",
    "ai-cost-owner-gate",
    "missing-tool-fallback",
    "owner-financial-gate"
  ],
  "codex": {
    "shortDescription": "Read LPM AI and AISH costs; run owner-ordered budget changes",
    "defaultPrompt": "Use $lpm-ai-cost to explain the AI and AISH cost, limits and budgets of LPM workspace <workspaceId>."
  }
}

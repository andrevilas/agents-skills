{
  "id": "lpm-ai-cost",
  "title": "AI and AISH cost governance",
  "version": "2.0.0",
  "pack": "core",
  "kind": "tools",
  "invocation": "implicit",
  "description": "Use when asked about LPM AI or AISH cost and limits (custo, orçamento): workspace AI policy, models, token/request budgets, Advisor limits, code-search quota, AISH budgets, pools, funding, consumption, accounting. Reads and proposes; changes are owner-only. Not for API keys (use lpm-access).",
  "doneWhen": "The cost question is answered from tool results, or a decision request with options and a recommendation is in front of the owner, or an owner-instructed change is re-read and quoted before/after.",
  "authorityCeiling": "Reads are [A]; accounting reconcile is [C]; 9 financial/model tools are [O] and run only on the owner's explicit instruction for that exact change.",
  "jobs": [
    "quanto gastamos com IA neste mês?",
    "troque o modelo do Advisor para o Pro",
    "desligue a análise de documentos para economizar",
    "qual o limite de uso do Advisor e da busca de código hoje?",
    "why did the Advisor answer with ai_usage_limit_reached?",
    "how much of the AISH budget of project <projectId> is left?",
    "fund AISH job <jobId> as the owner ordered",
    "reconcile the AISH accounting of activity <issueId>"
  ],
